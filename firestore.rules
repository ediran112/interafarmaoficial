rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Drug interactions are public read-only for all users
    match /drug_interactions/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Saved checks
    match /saved_checks/{checkId} {
      allow read, create, update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
