# =============================================================================
# OpenAI — motor de análise clínica (obrigatório)
# =============================================================================
OPENAI_API_KEY="sk-proj-..."

# Gemini — fallback opcional. Deixe vazio se não usar.
GEMINI_API_KEY=""

# URL da plataforma
APP_URL="https://interafarmaoficial.vercel.app"

# =============================================================================
# Web Push Notifications (VAPID)
# Gerar chaves: npm run vapid:gen
# =============================================================================

# Chave PÚBLICA — usada pelo frontend (por isso o prefixo VITE_ pra ser embutida)
# É PÚBLICA, pode ser exposta sem risco.
VITE_VAPID_PUBLIC_KEY=""

# Chaves usadas pelo backend / CLI de broadcast
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Identificação do remetente (mailto ou URL) — obrigatório pelo padrão VAPID
VAPID_SUBJECT="mailto:contato@interafarma.com.br"
